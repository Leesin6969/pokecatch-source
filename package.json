{
  "name": "pokecatch-source",
  "version": "1.2.0",
  "private": true,
  "description": "Full reverse-engineered source of the Poke'Catch idle Pokémon game (pokecatch-online.netlify.app): byte-faithful recovery + de-mangled readable tree + deep RE docs, audited 1:1 against the live site.",
  "type": "module",
  "author": "Hq3010",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hq3010/pokecatch-source.git"
  },
  "homepage": "https://github.com/Hq3010/pokecatch-source#readme",
  "bugs": {
    "url": "https://github.com/Hq3010/pokecatch-source/issues"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "node tools/build.mjs",
    "build:min": "node tools/build.mjs --minify",
    "build:readable": "node tools/build.mjs --src=src/readable/js --out=.cache/readable-dist",
    "serve": "node tools/serve.mjs --dir=dist",
    "check": "node tools/check.mjs",
    "check:play": "node tools/check.mjs --play",
    "verify": "node tools/verify.mjs",
    "play": "node tools/play.mjs",
    "compare": "node tools/compare.mjs",
    "data:export": "node tools/export-data.mjs",
    "demangle": "node tools/demangle.mjs",
    "verify:readable": "node tools/verify-readable.mjs",
    "extract:intros": "node tools/extract-intros.mjs",
    "intros:assets": "node tools/intros-scenes.mjs",
    "verify:intros": "node tools/verify-intros.mjs",
    "gen:api": "node tools/gen-api.mjs",
    "gen:arch": "node tools/gen-arch.mjs",
    "gen:network": "node tools/gen-network.mjs",
    "gen:models": "node tools/gen-data-models.mjs",
    "gen:docs": "node tools/gen-api.mjs && node tools/gen-arch.mjs && node tools/gen-network.mjs && node tools/gen-data-models.mjs",
    "audit:ast": "node tools/recovery/format-src.mjs",
    "audit:data": "node tools/audit-data.mjs",
    "audit:runtime": "node tools/audit-runtime.mjs --label=local --deep",
    "audit:i18n": "node tools/audit-i18n.mjs --label=local",
    "audit:diff": "node tools/audit-diff.mjs",
    "audit:assets": "node tools/audit-assets-loop.mjs",
    "audit:download": "node tools/audit-download.mjs",
    "audit:refs": "node tools/audit-references.mjs",
    "audit:requests": "node tools/audit-requests-diff.mjs",
    "audit:logs": "node tools/audit-logs.mjs",
    "probe:backend": "node tools/probe-backend.mjs",
    "audit-all": "node tools/audit-all.mjs",
    "gens:fetch": "node tools/gens/fetch-data.mjs",
    "gens:assets": "node tools/gens/fetch-assets.mjs",
    "gens:stills": "python tools/gens/make-stills.py",
    "gens:data": "node tools/gens2/build-moves.mjs && node tools/gens/build-data.mjs && node tools/gens2/build-story.mjs",
    "gens:build": "node tools/gens2/build-moves.mjs && node tools/gens/build-data.mjs && node tools/gens2/build-story.mjs && node tools/build.mjs",
    "gens:audit": "node tools/gens/audit-ext.mjs",
    "gens:probe": "node tools/gens/probe-ext.mjs",
    "gens:moves": "node tools/gens2/build-moves.mjs",
    "gens:forms": "node tools/gens2/build-forms.mjs",
    "gens:forms:assets": "node tools/gens2/build-forms.mjs && python tools/gens2/make-assets.py",
    "gens:story": "node tools/gens2/build-story.mjs",
    "i18n:prep": "node tools/i18n/prepare-jobs.mjs",
    "i18n:check": "node tools/i18n/check-chunks.mjs",
    "i18n:merge": "node tools/i18n/merge-vi.mjs",
    "i18n:probe": "node tools/i18n/probe-vi-final.mjs http://127.0.0.1:4470/",
    "verify:visibility": "node tools/probe-visibility.mjs http://127.0.0.1:4481/",
    "verify:no-fx": "node tools/probe-no-fx.mjs http://127.0.0.1:4481/"
  },
  "keywords": [
    "pokemon",
    "idle-game",
    "reverse-engineering",
    "decompile",
    "source-recovery",
    "demangle"
  ],
  "devDependencies": {
    "@babel/parser": "^8.1.2",
    "@babel/traverse": "^8.1.2",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "puppeteer-core": "^24.43.1",
    "terser": "^5.51.2"
  }
}
